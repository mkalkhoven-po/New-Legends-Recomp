// Icon, version information and the setup window for newlegends.exe
// (the manifest is res/newlegends.manifest, merged in by CMake).
#include <winres.h>
#include <commctrl.h>

#include "../runtime/include/setup_ids.h"
#include "../runtime/include/version.h"

1 ICON "newlegends.ico"

IDD_SETUP DIALOGEX 0, 0, 290, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Legends Recomp - setup"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "", IDC_INTRO, 12, 10, 266, 42
    PUSHBUTTON "Choose disc image (.iso, .xiso)...", IDC_PICK_IMAGE, 12, 58, 130, 18
    PUSHBUTTON "Choose folder with the game files...", IDC_PICK_FOLDER, 148, 58, 130, 18
    AUTOCHECKBOX "Make a shortcut on the desktop", IDC_DESKTOP, 12, 88, 266, 10
    AUTOCHECKBOX "Add to the Start menu", IDC_STARTMENU, 12, 102, 266, 10
    LTEXT "", IDC_STATUS, 12, 120, 266, 34
    CONTROL "", IDC_PROGRESS, PROGRESS_CLASS, WS_BORDER, 12, 156, 266, 9
    DEFPUSHBUTTON "Start", IDOK, 174, 174, 50, 14
    PUSHBUTTON "Quit", IDCANCEL, 228, 174, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION NL_VERSION_MAJOR, NL_VERSION_MINOR, NL_VERSION_PATCH, 0
PRODUCTVERSION NL_VERSION_MAJOR, NL_VERSION_MINOR, NL_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "New Legends Recomp: native PC version of New Legends (Xbox)"
            VALUE "FileVersion", NL_VERSION_STRING
            VALUE "ProductName", NL_PRODUCT_NAME
            VALUE "ProductVersion", NL_VERSION_STRING
            VALUE "OriginalFilename", "newlegends.exe"
            VALUE "Comments", "Unofficial fan project. Requires your own copy of the game."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
